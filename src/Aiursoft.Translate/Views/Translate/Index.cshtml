@using Aiursoft.Translate.Models.TranslateViewModels
@using Aiursoft.Translate.Controllers
@using Aiursoft.WebTools.OfficialPlugins
@model IndexViewModel
@{
    var isDarkMode = Context.Request.Cookies[ThemeController.ThemeCookieKey] == true.ToString();
}

<div class="d-flex flex-column h-100 pb-0">
    <!-- Unified Sticky Toolbar -->
    <div class="sticky-top bg-white border-bottom py-2 px-3 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2 z-3" style="box-shadow: 0 2px 4px rgba(0,0,0,.04);">
        <!-- Left: Branding -->
        <div class="d-flex align-items-center gap-3">
             <h4 class="mb-0 fw-bold"><i class="align-middle me-1" data-lucide="languages"></i> @Model.AppName</h4>
             <span class="text-muted d-none d-lg-inline-block border-start ps-3" style="font-size: 0.85rem; letter-spacing: 0.02rem;">
                 @Localizer["Empower your translations with local AI: Private, flexible, and faithful."]
             </span>
        </div>

        <!-- Middle: Options -->
        <div class="flex-grow-1 px-4 text-center d-flex align-items-center justify-content-center gap-2 flex-nowrap">
            <label class="form-label mb-0 d-none d-md-inline">@Localizer["Target Language:"]</label>
            <select id="targetLanguage" class="form-select form-select-sm shadow-sm" style="max-width: 250px;">
                @foreach (var culture in LocalizationPlugin.SupportedCultures)
                {
                    <option value="@culture.Key">@culture.Value (@culture.Key)</option>
                }
            </select>
        </div>

        <!-- Right: Actions -->
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <!-- View Mode Toggle: Desktop shows 3 options, Mobile shows 2 -->
            <div class="btn-group btn-group-sm shadow-none view-toggle" role="group" aria-label="View mode" style="min-width: max-content;">
                <button type="button" id="viewBothBtn" class="btn btn-outline-secondary view-btn d-none d-lg-inline-flex active" data-view="both" title="@Localizer["Original + Translation"]">
                    <i class="align-middle" data-lucide="columns-2"></i>
                    <span class="d-none d-xl-inline ms-1">@Localizer["Both"]</span>
                </button>
                <button type="button" id="viewSourceBtn" class="btn btn-outline-secondary view-btn active d-lg-none" data-view="source" title="@Localizer["Original only"]">
                    <i class="align-middle" data-lucide="file-text"></i>
                    <span class="d-none d-xl-inline ms-1">@Localizer["Original"]</span>
                </button>
                <button type="button" id="viewResultBtn" class="btn btn-outline-secondary view-btn" data-view="result" title="@Localizer["Translation only"]">
                    <i class="align-middle" data-lucide="languages"></i>
                    <span class="d-none d-xl-inline ms-1">@Localizer["Translation"]</span>
                </button>
            </div>
            <button type="button" id="translateBtn" class="btn btn-sm btn-primary shadow-sm px-3 fw-bold flex-shrink-0">
                <span id="btnTextNormal"><i class="align-middle me-1" data-lucide="zap"></i> @Localizer["Translate"]</span>
                <span id="btnTextStop" class="d-none"><i class="align-middle me-1" data-lucide="square"></i> @Localizer["Stop"]</span>
                <span id="btnLoading" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <div id="translation-feedback" class="d-none border-bottom px-3 py-2 bg-body-tertiary text-body-emphasis">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span id="translation-feedback-text" class="small" role="status" aria-live="polite" aria-atomic="true"></span>
            <button type="button" id="retryTranslationBtn" class="btn btn-sm btn-primary">@Localizer["Translate again"]</button>
        </div>
    </div>

    <!-- Content Area -->
    <div class="row flex-grow-1 gx-0 content-area" style="height: calc(100vh - 120px); min-height: 400px; background-color: #F9FAFB;">

        @* --- Left Column: Source Editor --- *@
        <div id="sourceColumn" class="col-lg-6 h-100 border-end column-source" style="border-color: #eaecef !important;">
            <div class="h-100 d-flex flex-column bg-white">
                <div class="flex-grow-1 position-relative editor-wrapper">
                    <div id="source-editor-container" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;"></div>
                </div>
            </div>
        </div>

        @* --- Right Column: Result Editor --- *@
        <div id="resultColumn" class="col-lg-6 h-100 border-end column-result" style="border-color: #eaecef !important;">
             <div class="h-100 d-flex flex-column bg-white">
                <div class="flex-grow-1 position-relative editor-wrapper">
                    <div id="result-editor-container" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Localization data for JavaScript (server-rendered, never mix @Localizer inside <script>) -->
<div id="loc-data" data-dark-mode="@isDarkMode.ToString().ToLowerInvariant()" data-translate-url="@Url.Action("TranslateStream", "Translate")" data-login-url="@Url.Action("Login", "Account")" hidden>
    <span data-key="enter-content">@Localizer["Please enter some content to translate."]</span>
    <span data-key="too-many-requests">@Localizer["Too many requests, please wait."]</span>
    <span data-key="translation-failed">@Localizer["Translation failed."]</span>
    <span data-key="translation-interrupted">@Localizer["Translation interrupted. The result is incomplete."]</span>
    <span data-key="previous-translation-kept">@Localizer["Translation failed. Previous text has been kept."]</span>
    <span data-key="translation-stopped">@Localizer["Translation stopped. The result may be incomplete."]</span>
    <span data-key="sign-in-required">@Localizer["Sign in, then translate again."]</span>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/@@fontsource/cascadia-code/index.css" asp-append-version="true" />
    <style>
        main.content {
            padding: 0 !important;
        }
        /* Toolbar adjustments for dark mode */
        html[data-bs-theme="dark"] .sticky-top {
            background-color: #222e3c !important; /* AdminKit dark background */
            border-bottom: 1px solid #323d4b !important;
        }
        html[data-bs-theme="dark"] .bg-white {
            background-color: #222e3c !important;
        }
        html[data-bs-theme="dark"] .border-end {
            border-color: #323d4b !important;
        }

        .editor-wrapper {
            background-color: #fff;
        }

        html[data-bs-theme="dark"] .editor-wrapper {
            background-color: #1e2530 !important;
        }

        .sticky-top {
            top: 0;
            position: sticky;
        }

        /* CodeMirror 6: fill the absolute-positioned container divs */
        #source-editor-container .cm-editor,
        #result-editor-container .cm-editor {
            height: 100%;
            font-family: 'Cascadia Code', Consolas, 'Courier New', monospace;
            font-size: 14px;
        }
        #source-editor-container .cm-scroller,
        #result-editor-container .cm-scroller {
            overflow: auto;
            height: 100%;
        }

        /* View Mode Styles */
        .view-toggle {
            /* Fixed width to prevent layout jump: fits 3 icon-only or 2 icon+text buttons */
        }

        @@media (min-width: 992px) {
            .view-toggle {
                width: auto; /* Let it size naturally for 3 buttons */
            }
        }

        @@media (max-width: 991.98px) {
            .view-toggle {
                width: max-content; /* Size naturally for 2 mobile buttons, no shrink */
            }
        }

        .view-btn.active {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
            color: white;
        }

        .column-source,
        .column-result {
            transition: all 0.3s ease;
        }

        /* Both view (default) - show both columns side by side */
        .content-area[data-view="both"] #sourceColumn,
        .content-area[data-view="both"] #resultColumn {
            display: block !important;
            width: 50% !important;
            flex: 0 0 auto;
        }

        /* Source only view - full width source column */
        .content-area[data-view="source"] #sourceColumn {
            display: block !important;
            width: 100% !important;
            flex: 0 0 auto;
        }
        .content-area[data-view="source"] #resultColumn {
            display: none !important;
        }

        /* Result only view - full width result column */
        .content-area[data-view="result"] #sourceColumn {
            display: none !important;
        }
        .content-area[data-view="result"] #resultColumn {
            display: block !important;
            width: 100% !important;
            flex: 0 0 auto;
        }

        /* Mobile: default to source-only view on small screens */
        @@media (max-width: 991.98px) {
            .content-area:not([data-view]) #sourceColumn,
            .content-area[data-view="both"] #sourceColumn,
            .content-area[data-view="source"] #sourceColumn {
                display: block !important;
                width: 100% !important;
                flex: 0 0 auto;
            }
            .content-area:not([data-view]) #resultColumn,
            .content-area[data-view="both"] #resultColumn,
            .content-area[data-view="source"] #resultColumn {
                display: none !important;
            }
            .content-area[data-view="result"] #sourceColumn {
                display: none !important;
            }
            .content-area[data-view="result"] #resultColumn {
                display: block !important;
                width: 100% !important;
                flex: 0 0 auto;
            }
        }

        html[data-bs-theme="dark"] .view-btn.active {
            background-color: var(--bs-primary);
            color: white;
        }
    </style>
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/codemirror-bundle.js" asp-append-version="true"></script>
    <script src="~/scripts/translate.js" asp-append-version="true"></script>
}

@Html.AntiForgeryToken()
